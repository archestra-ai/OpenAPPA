# The FIDES corporate demo talks to an OpenAI-compatible endpoint (OpenRouter by
# default). Only the agent needs a key; the systems layer and the tests do not.
OPENROUTER_API_KEY="sk-or-..."

# Optional overrides (all have defaults):
# FIDES_DEMO_MODEL="anthropic/claude-sonnet-5"
# FIDES_QUARANTINE_MODEL="anthropic/claude-haiku-4-5-20251001"
# CORP_DATA_ROOT="/abs/path/to/a/different/corpus"
