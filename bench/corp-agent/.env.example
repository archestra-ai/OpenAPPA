# Copy this file to `.env` and fill in your key. `.env` is git-ignored, so your
# key is never committed. The agent loads `.env` automatically (this crate's
# `.env` first, then the repository-root one).

# Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-...

# Any valid OpenRouter model id. The scripts and the agent default to this.
APPA_DEMO_MODEL=openai/gpt-5.6-luna
