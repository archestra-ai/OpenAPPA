{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appa-runtime values",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": ["existingConfigMap", "existingClaim", "key", "contents", "files"],
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": { "type": "string" },
        "existingClaim": { "type": "string" },
        "key": { "type": "string", "minLength": 1, "maxLength": 253 },
        "contents": { "type": "string" },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["data", "executable"],
            "additionalProperties": false,
            "properties": {
              "data": { "type": "string" },
              "executable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "existingClaim": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "guidePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "sidecars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "image"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 },
          "securityContext": { "type": "object" }
        }
      }
    },
    "appaGuide": {
      "type": "object",
      "properties": {
        "reasoningEffort": { "type": "string" }
      }
    }
  }
}
