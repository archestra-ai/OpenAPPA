# The HR file makes the trajectory private. The email is denied: it needs
# `public`. The channel post is still allowed: it needs only `private`.
Read {
  path: "/hr/salaries.csv"
}
expect allow

Email {
  to: "x@other.com"
  subject: "salaries"
}
expect deny

PostToChannel {
  channel: "#hr"
  text: "salaries reviewed"
}
expect allow
