# The HR file restricts the trajectory to `internal`. The email is denied: it
# needs `public`. The channel post is still allowed: it needs only `internal`.
Read {
  path: "/hr/salaries.csv"
}
expect allow

Email {
  to: "x@other.com"
  subject: "salaries"
}
expect deny

PostToChannel {
  channel: "#hr"
  text: "salaries reviewed"
}
expect allow
