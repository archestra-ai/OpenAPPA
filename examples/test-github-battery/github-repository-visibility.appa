# Replace these names with one public repository and one private repository
# that APPA_PROVIDER_GITHUB_TOKEN can read.

mcp/github/get_file_contents {
  owner: "your-org"
  repo: "your-public-repo"
  path: "README.md"
}
expect allow

mcp/shell/run_command {
  command: "deploy"
}
expect deny

mcp/mail/send {
  to: "public"
}
expect allow

mcp/github/get_file_contents {
  owner: "your-org"
  repo: "your-private-repo"
  path: "README.md"
}
expect allow

mcp/mail/send {
  to: "public"
}
expect deny

mcp/mail/send {
  to: "github:internal"
}
expect allow
