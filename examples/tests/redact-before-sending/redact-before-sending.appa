# A public read is safe. HR data must go through the redactor before an email.
mcp/files/read {
  path: "/docs/handbook.md"
}
expect allow

mcp/mail/send {
  to: "x@other.com"
  body: "the handbook"
}
expect allow

mcp/files/read {
  path: "/hr/salaries.csv"
}
expect allow

mcp/mail/send {
  to: "x@other.com"
  body: "see attached"
}
expect sanitizer redactor

mcp/mail/send {
  to: "y@other.com"
  body: "and this"
}
expect sanitizer redactor
