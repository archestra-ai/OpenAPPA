# The actor's EgressPolicy: two hosts, each with its credential injected.
# Applied with `kubectl ate create egress-policy agent -f -`.
#
# A read of a private repository and a comment on a public issue both go to
# api.githubcopilot.com, so this policy cannot tell them apart. OpenAPPA, on
# the same gateway, does.
rules:
- https:
    hostnames: ["api.anthropic.com"]
    effects:
      replaceHeaders:
      - header: Authorization
        prefix: "Bearer "
        credentialUri: ate-secret://k8s.io/default/appa-substrate-demo/appa-substrate-demo-credentials/claude-code-oauth-token
- https:
    hostnames: ["api.githubcopilot.com"]
    effects:
      replaceHeaders:
      - header: Authorization
        prefix: "Bearer "
        credentialUri: ate-secret://k8s.io/default/appa-substrate-demo/appa-substrate-demo-credentials/github-token
